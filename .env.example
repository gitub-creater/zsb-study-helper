# Vercel server-side environment variables. Do not commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Optional: allow only your deployed site and desktop local server to call the API.
CORS_ORIGINS=https://your-project.vercel.app,http://localhost:5173

# Optional at build time. Required by the local desktop build so it can reach the cloud API.
# Multiple HTTPS addresses may be separated with commas or semicolons; the client
# tries them in order after a short timeout. Put a mainland-reachable,备案域名 first
# when you have one. GitHub Pages itself cannot serve /api routes.
VITE_CLOUD_API_URL=https://your-project.vercel.app
VITE_CLOUD_API_URLS=https://your-project.vercel.app,https://your-mainland-relay.example.cn

# Public browser variables for Supabase Realtime features (never use service-role here).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-publishable-key
VITE_RTC_WS_URL=wss://your-rtc-service.example.com
